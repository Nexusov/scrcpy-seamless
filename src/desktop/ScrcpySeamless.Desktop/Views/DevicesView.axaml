<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScrcpySeamless.Desktop.Presentation"
             xmlns:views="using:ScrcpySeamless.Desktop.Views"
             x:Class="ScrcpySeamless.Desktop.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource PageInset}" Spacing="{DynamicResource SectionGap}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="5">
          <TextBlock Classes="eyebrow" Text="{Binding Eyebrow}" />
          <TextBlock Classes="pageTitle" Text="{Binding Title}" />
          <TextBlock Classes="muted" Text="{Binding Subtitle}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding IsPreview}"
                    VerticalAlignment="Bottom" MinWidth="210">
          <TextBlock Text="{Binding ScenarioLabel}" FontSize="{DynamicResource SmallFontSize}" Classes="muted" />
          <ComboBox Name="ScenarioPicker" ItemsSource="{Binding Scenarios}"
                    SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
                    AutomationProperties.AutomationId="preview.scenario"
                    AutomationProperties.Name="{Binding ScenarioLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceScenarioChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
      <!-- Live controls are visible only when composition explicitly attaches ADB services. -->
      <StackPanel IsVisible="{Binding IsLiveEnabled}" Spacing="12">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="sectionTitle" Text="{Binding LiveDiscoveryTitle}" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}"
                      IsEnabled="{Binding CanRefresh}" AutomationProperties.AutomationId="devices.refresh" />
              <Button Content="{Binding CancelRefreshLabel}" Command="{Binding CancelRefreshCommand}"
                      IsEnabled="{Binding CanCancelRefresh}" AutomationProperties.AutomationId="devices.cancelRefresh" />
            </WrapPanel>
            <TextBlock Text="{Binding DiscoveryStatusLabel}" Classes="muted" />
            <TextBlock Text="{Binding DiscoveryMessage}" TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="{Binding StaleMessage}"
                       Classes="muted" IsVisible="{Binding IsObservationStale}" />
            <ComboBox ItemsSource="{Binding ObservedDevices}"
                      SelectedItem="{Binding SelectedDeviceChoice, Mode=TwoWay}"
                      AutomationProperties.AutomationId="devices.observedSelection">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ObservedDeviceChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="sectionTitle" Text="{Binding LivePairingTitle}" />
            <TextBlock Text="{Binding PairingDescription}"
                       TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="{Binding PairingServiceLabel}" Classes="muted" />
            <ComboBox ItemsSource="{Binding PairingServices}"
                      SelectedItem="{Binding SelectedPairingService, Mode=TwoWay}"
                      AutomationProperties.AutomationId="devices.pairingService">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ObservedServiceChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox PlaceholderText="{Binding ManualPairingLabel}" Text="{Binding ManualPairingEndpoint, Mode=TwoWay}"
                     AutomationProperties.AutomationId="devices.manualPairingEndpoint" />
            <TextBlock Text="{Binding ConnectionServiceLabel}" Classes="muted" />
            <ComboBox ItemsSource="{Binding ConnectionServices}"
                      SelectedItem="{Binding SelectedConnectionService, Mode=TwoWay}"
                      AutomationProperties.AutomationId="devices.connectionService">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ObservedServiceChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox PlaceholderText="{Binding ManualConnectionLabel}" Text="{Binding ManualConnectionEndpoint, Mode=TwoWay}"
                     AutomationProperties.AutomationId="devices.manualConnectionEndpoint" />
            <TextBlock Text="{Binding ServiceMessage}" TextWrapping="Wrap" Classes="muted" />
            <TextBox PlaceholderText="{Binding PairCodeLabel}" PasswordChar="●" MaxLength="6"
                     Text="{Binding PairingCode, Mode=TwoWay}"
                     AutomationProperties.AutomationId="devices.pairingCode" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <Button Content="{Binding PairLabel}" Command="{Binding PairCommand}" IsEnabled="{Binding CanPair}"
                      AutomationProperties.AutomationId="devices.pair" />
              <Button Content="{Binding CancelPairLabel}" Command="{Binding CancelPairCommand}"
                      IsEnabled="{Binding CanCancelPair}" AutomationProperties.AutomationId="devices.cancelPair" />
            </WrapPanel>
            <TextBlock Text="{Binding PairingMessage}" TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="{Binding ConnectedEndpointLabel}" TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding SessionActions}" IsVisible="{Binding HasSessionActions}" />
      <Border Classes="card" IsVisible="{Binding IsEmpty}"
              AutomationProperties.AutomationId="devices.empty">
        <StackPanel Spacing="12" Margin="4,8,4,12">
          <TextBlock Text="{Binding EmptyTitle}" Classes="sectionTitle" />
          <TextBlock Text="{Binding EmptyBody}" Classes="muted" MaxWidth="560"
                     HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DeviceCardViewModel">
            <views:DeviceCardView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
