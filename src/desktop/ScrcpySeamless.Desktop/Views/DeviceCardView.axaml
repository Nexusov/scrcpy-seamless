<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScrcpySeamless.Desktop.Presentation"
             x:Class="ScrcpySeamless.Desktop.Views.DeviceCardView"
             x:DataType="vm:DeviceCardViewModel">
  <Border Classes="card" AutomationProperties.AutomationId="{Binding StableId}">
    <StackPanel Spacing="22">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding DisplayName}" Classes="sectionTitle" />
          <TextBlock Text="{Binding StableId}" FontSize="11" Classes="muted" />
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}"
                CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
          <TextBlock Text="{Binding Availability}" Foreground="{DynamicResource AccentBrush}"
                     FontWeight="SemiBold" FontSize="11" />
        </Border>
      </Grid>
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding AvailableHeading}" Classes="eyebrow" />
        <ItemsControl ItemsSource="{Binding AvailabilityMetrics}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StatusMetric">
              <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8"
                      Padding="12,9" Width="170" Margin="0,0,8,8"
                      AutomationProperties.AutomationId="{Binding AutomationId}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Label}" FontSize="11" Classes="muted" />
                  <TextBlock Text="{Binding Value}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding SessionHeading}" Classes="eyebrow" />
        <ItemsControl ItemsSource="{Binding SessionMetrics}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StatusMetric">
              <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8"
                      Padding="12,9" Width="170" Margin="0,0,8,8"
                      AutomationProperties.AutomationId="{Binding AutomationId}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Label}" FontSize="11" Classes="muted" />
                  <TextBlock Text="{Binding Value}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8"
              Padding="14,11" IsVisible="{Binding IsProblem}">
        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="{Binding Hint}" Classes="muted" IsVisible="{Binding IsInformational}" />
      <TextBlock Text="{Binding PreviewNote}" Classes="muted" IsVisible="{Binding IsPreview}"
                 FontSize="11" />
    </StackPanel>
  </Border>
</UserControl>
