<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScrcpySeamless.Desktop.Presentation"
             xmlns:views="using:ScrcpySeamless.Desktop.Views"
             x:Class="ScrcpySeamless.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Grid Name="SettingsRoot" RowDefinitions="Auto,Auto,*" Margin="{DynamicResource PageInset}" RowSpacing="{DynamicResource SectionGap}">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="5">
        <TextBlock Name="SettingsEyebrow" Classes="eyebrow" Text="{Binding Eyebrow}" />
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Name="SettingsSubtitle" Classes="muted" Text="{Binding Subtitle}" />
      </StackPanel>
      <Button Name="ResetDraftButton" Grid.Column="1" Content="{Binding ResetLabel}" Command="{Binding ResetDraftCommand}"
              IsVisible="{Binding IsPreview}"
              VerticalAlignment="Bottom" AutomationProperties.AutomationId="settings.resetDraft"
              AutomationProperties.Name="{Binding ResetLabel}" />
    </Grid>
    <Border Name="SettingsStatusBlock" Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8"
            Padding="16,11">
      <StackPanel Spacing="4">
        <TextBlock Name="SettingsGlobalLabel" Text="{Binding GlobalLabel}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Name="SettingsUnsavedLabel" Text="{Binding UnsavedLabel}" Classes="muted"
                   FontSize="{DynamicResource SmallFontSize}" />
        <!-- Configuration actions apply only to the selected normal-mode data root. -->
        <TextBlock Name="SettingsConfigurationStatus" Text="{Binding ConfigurationStatusMessage}"
                   IsVisible="{Binding IsPersistent}" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ConfigurationStatusMessage}"
                   AutomationProperties.HelpText="{Binding ConfigurationStatusMessage}"
                   AutomationProperties.AutomationId="configuration.status" />
        <WrapPanel IsVisible="{Binding IsPersistent}" ItemSpacing="8" LineSpacing="8">
          <Button Name="ConfigurationApplyButton" Content="{Binding ConfigurationApplyLabel}" Command="{Binding Configuration.ApplyCommand}"
                  AutomationProperties.AutomationId="configuration.apply" />
          <Button Name="ConfigurationCancelButton" Content="{Binding ConfigurationCancelLabel}" Command="{Binding Configuration.CancelCommand}"
                  AutomationProperties.AutomationId="configuration.cancel" />
          <Button Content="{Binding ConfigurationReloadLabel}" Command="{Binding Configuration.ReloadCommand}"
                  AutomationProperties.AutomationId="configuration.reload" />
        </WrapPanel>
        <WrapPanel IsVisible="{Binding IsPersistent}" ItemSpacing="8" LineSpacing="8">
          <Button Content="{Binding MigrationPrepareLabel}" Command="{Binding Configuration.PrepareMigrationCommand}"
                  IsVisible="{Binding Configuration.CanPrepareMigration}"
                  AutomationProperties.AutomationId="configuration.migration.prepare" />
          <TextBlock Text="{Binding MigrationSummaryMessage}" IsVisible="{Binding Configuration.HasPreparedMigration}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Content="{Binding MigrationCommitLabel}" Command="{Binding Configuration.CommitMigrationCommand}"
                  IsVisible="{Binding Configuration.HasPreparedMigration}"
                  AutomationProperties.AutomationId="configuration.migration.commit" />
          <Button Content="{Binding MigrationCancelLabel}" Command="{Binding Configuration.CancelMigrationCommand}"
                  IsVisible="{Binding Configuration.HasPreparedMigration}"
                  AutomationProperties.AutomationId="configuration.migration.cancel" />
        </WrapPanel>
        <WrapPanel IsVisible="{Binding IsPersistent}" ItemSpacing="8">
          <Button Content="{Binding MirroringSectionLabel}" Command="{Binding ShowMirroringCommand}"
                  AutomationProperties.AutomationId="settings.section.mirroring" />
          <Button Content="{Binding DesktopSectionLabel}" Command="{Binding ShowDesktopCommand}"
                  AutomationProperties.AutomationId="settings.section.desktop" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <!-- Compact normal-mode actions preserve an option viewport at enlarged laptop metrics. -->
    <Border Name="CompactSettingsToolbar" Grid.Row="1" IsVisible="False"
            Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8" Padding="8">
      <StackPanel Spacing="4" ToolTip.Tip="{Binding ConfigurationStatusMessage}"
                  AutomationProperties.HelpText="{Binding ConfigurationStatusMessage}">
        <TextBlock Text="{Binding ConfigurationStatusMessage}" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="configuration.compactStatus" />
        <WrapPanel ItemSpacing="6">
          <Button Name="CompactConfigurationApplyButton" Content="{Binding ConfigurationApplyLabel}" Command="{Binding Configuration.ApplyCommand}"
                  AutomationProperties.AutomationId="configuration.compactApply" />
          <Button Name="CompactConfigurationCancelButton" Content="{Binding ConfigurationCancelLabel}" Command="{Binding Configuration.CancelCommand}"
                  AutomationProperties.AutomationId="configuration.compactCancel" />
          <Button Content="{Binding ConfigurationReloadLabel}" Command="{Binding Configuration.ReloadCommand}"
                  AutomationProperties.AutomationId="configuration.compactReload" />
          <Button Content="{Binding MigrationPrepareLabel}" Command="{Binding Configuration.PrepareMigrationCommand}"
                  IsVisible="{Binding Configuration.CanPrepareMigration}"
                  AutomationProperties.AutomationId="configuration.compactMigration" />
        </WrapPanel>
        <WrapPanel ItemSpacing="6">
          <Button Content="{Binding MirroringSectionLabel}" Command="{Binding ShowMirroringCommand}" />
          <Button Content="{Binding DesktopSectionLabel}" Command="{Binding ShowDesktopCommand}" />
        </WrapPanel>
        <WrapPanel IsVisible="{Binding Configuration.HasPreparedMigration}" ItemSpacing="6">
          <TextBlock Text="{Binding MigrationSummaryMessage}" TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" MaxWidth="220" VerticalAlignment="Center"
                     ToolTip.Tip="{Binding MigrationSummaryMessage}" />
          <Button Content="{Binding MigrationCommitLabel}" Command="{Binding Configuration.CommitMigrationCommand}"
                  AutomationProperties.AutomationId="configuration.compactMigrationCommit" />
          <Button Content="{Binding MigrationCancelLabel}" Command="{Binding Configuration.CancelMigrationCommand}"
                  AutomationProperties.AutomationId="configuration.compactMigrationCancel" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Grid Name="SettingsColumns" Grid.Row="2" ColumnDefinitions="160,*" ColumnSpacing="18"
          IsVisible="{Binding IsMirroringSection}" IsEnabled="{Binding IsOptionEditorAvailable}">
      <Grid Name="CategoryNavigation" Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="{Binding CategoriesLabel}" Classes="eyebrow" />
        <ListBox Name="CategoryList" ItemsSource="{Binding Categories}"
                 Grid.Row="1"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 AutomationProperties.AutomationId="settings.categories"
                 AutomationProperties.Name="{Binding CategoriesLabel}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsCategory">
              <TextBlock Text="{Binding Label}" Margin="6,4" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <ComboBox Name="CompactCategoryPicker" Grid.Column="0" IsVisible="False"
                ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                AutomationProperties.AutomationId="settings.compactCategories"
                AutomationProperties.Name="{Binding CategoriesLabel}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsCategory">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Grid Name="SettingsResults" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
          <TextBox Name="OptionSearch" Grid.Row="0" Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="{Binding SearchWatermark}"
                   AutomationProperties.AutomationId="settings.search"
                   AutomationProperties.Name="{Binding SearchLabel}" />
          <TextBlock Name="SettingsShortcutHelp" Grid.Row="1" Text="{Binding ShortcutHelp}" Classes="muted" />
        </Grid>
        <ScrollViewer Name="OptionScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding EmptyLabel}" IsVisible="{Binding HasNoResults}"
                       Classes="muted" Margin="8,16" />
            <ItemsControl ItemsSource="{Binding VisibleRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OptionRowViewModel">
                  <views:OptionRowView />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <ContentControl Grid.Row="2" Content="{Binding Preferences}"
                    IsVisible="{Binding IsDesktopSection}" />
  </Grid>
</UserControl>
