<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScrcpySeamless.Desktop.Presentation"
             x:Class="ScrcpySeamless.Desktop.Views.DeviceSessionView"
             x:DataType="vm:DeviceSessionViewModel">
  <Border Classes="card">
    <StackPanel Spacing="10">
      <TextBlock Classes="sectionTitle" Text="Mirror session" />
      <TextBlock Text="Select and save a profile in Profiles, then select a fresh ADB transport above."
                 TextWrapping="Wrap" Classes="muted" />
      <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedLaunchProfile, Mode=TwoWay}"
                AutomationProperties.AutomationId="devices.launchProfile">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SavedProfileChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
        <Button Content="Mirror" Command="{Binding MirrorCommand}"
                AutomationProperties.AutomationId="devices.mirror" />
        <Button Content="Stop" Command="{Binding StopCommand}"
                AutomationProperties.AutomationId="devices.stop" />
        <!-- Focus targets only the currently owned mirror session. -->
        <Button Content="{Binding FocusLabel}" Command="{Binding FocusCommand}"
                AutomationProperties.AutomationId="devices.focusMirror" />
        <!-- Explicit DEV-only copy reads retained evidence without changing the session. -->
        <Button Content="Copy session evidence" Command="{Binding CopySessionEvidenceCommand}"
                IsVisible="{Binding CanCopySessionEvidence}"
                AutomationProperties.AutomationId="devices.copySessionEvidence" />
      </WrapPanel>
      <TextBlock Text="{Binding HostModeStatus}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding FocusStatus}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="{Binding EvidenceCopyStatus}" TextWrapping="Wrap" Classes="muted"
                 IsVisible="{Binding CanCopySessionEvidence}" />
      <TextBlock Text="{Binding ChannelEvidence}" Classes="muted" />
      <TextBlock Text="{Binding ProcessId, StringFormat='Owned native PID: {0}'}" Classes="muted" />
      <TextBlock Text="{Binding WindowHandle, StringFormat='Observed HWND: {0}'}"
                 IsVisible="{Binding HasObservedWindowHandle}" Classes="muted" />
    </StackPanel>
  </Border>
</UserControl>
