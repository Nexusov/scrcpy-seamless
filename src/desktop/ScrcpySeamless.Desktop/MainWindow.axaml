<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ScrcpySeamless.Desktop"
        x:Class="ScrcpySeamless.Desktop.MainWindow"
        x:DataType="local:ShellViewModel"
        Title="{Binding ProductName}"
        Width="1080"
        Height="720"
        MinWidth="780"
        MinHeight="580"
        Background="{DynamicResource CanvasBrush}">
  <Grid ColumnDefinitions="208,*">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
            Padding="16,24">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="28">
        <StackPanel Grid.Row="0" Spacing="4" Margin="8,0">
          <TextBlock Text="{Binding ProductName}" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding ProductSubtitle}" FontSize="11" Classes="muted" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="5">
          <Button Name="DevicesNavigation" Classes="nav" Classes.active="{Binding IsDevicesSelected}"
                  Content="{Binding DevicesLabel}" Command="{Binding ShowDevicesCommand}"
                  AutomationProperties.AutomationId="nav.devices"
                  AutomationProperties.Name="{Binding DevicesLabel}" />
          <Button Classes="nav" Content="{Binding SessionsLabel}" IsEnabled="False"
                  ToolTip.Tip="{Binding UnavailableHint}" AutomationProperties.AutomationId="nav.sessions"
                  AutomationProperties.Name="{Binding SessionsLabel}" />
          <Button Classes="nav" Content="{Binding ProfilesLabel}" IsEnabled="False"
                  ToolTip.Tip="{Binding UnavailableHint}" AutomationProperties.AutomationId="nav.profiles"
                  AutomationProperties.Name="{Binding ProfilesLabel}" />
          <Button Name="SettingsNavigation" Classes="nav" Classes.active="{Binding IsSettingsSelected}"
                  Content="{Binding SettingsLabel}" Command="{Binding ShowSettingsCommand}"
                  AutomationProperties.AutomationId="nav.settings"
                  AutomationProperties.Name="{Binding SettingsLabel}" />
          <Button Classes="nav" Content="{Binding DiagnosticsLabel}" IsEnabled="False"
                  ToolTip.Tip="{Binding UnavailableHint}" AutomationProperties.AutomationId="nav.diagnostics"
                  AutomationProperties.Name="{Binding DiagnosticsLabel}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="12">
          <Button Content="{Binding ThemeButtonLabel}" Command="{Binding ToggleThemeCommand}"
                  AutomationProperties.AutomationId="theme.toggle"
                  AutomationProperties.Name="{Binding ThemeButtonLabel}" />
          <TextBlock Text="{Binding UnavailableHint}" FontSize="11" Classes="muted" Margin="4,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="{DynamicResource AccentSoftBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
              Padding="24,12">
        <TextBlock Text="{Binding ModeLabel}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
      </Border>
      <ContentControl Name="WorkspaceContent" Grid.Row="1" Content="{Binding CurrentPage}"
                      AutomationProperties.AutomationId="workspace.content" />
    </Grid>
  </Grid>
</Window>
