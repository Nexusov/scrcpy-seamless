<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ScrcpySeamless.Desktop"
        x:Class="ScrcpySeamless.Desktop.MainWindow"
        x:DataType="local:ShellViewModel"
        Title="scrcpy Seamless"
        Width="480"
        Height="180">
  <TextBlock Name="FoundationStatus"
             Text="{Binding Status}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />
</Window>
