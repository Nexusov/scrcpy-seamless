<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ScrcpySeamless.Desktop.Views"
             xmlns:vm="using:ScrcpySeamless.Desktop.Presentation"
             x:Class="ScrcpySeamless.Desktop.App">
  <Application.Resources>
    <ResourceDictionary>
      <Thickness x:Key="SpaceSmall">8</Thickness>
      <Thickness x:Key="SpaceMedium">16</Thickness>
      <Thickness x:Key="SpaceLarge">24</Thickness>
      <Thickness x:Key="SpaceSection">32</Thickness>
      <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
      <CornerRadius x:Key="RadiusCard">14</CornerRadius>
      <x:Double x:Key="IconSize">18</x:Double>
      <x:Double x:Key="BodyFontSize">13</x:Double>
      <x:Double x:Key="SmallFontSize">11</x:Double>
      <x:Double x:Key="TitleFontSize">28</x:Double>
      <x:Double x:Key="SectionFontSize">16</x:Double>
      <Thickness x:Key="PageInset">24,16</Thickness>
      <x:Double x:Key="SectionGap">14</x:Double>
      <x:Double x:Key="EditorBelowWidth">620</x:Double>
      <Thickness x:Key="ControlPadding">10,7</Thickness>
      <Thickness x:Key="NavPadding">14,11</Thickness>
      <x:Double x:Key="MotionQuickMilliseconds">120</x:Double>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7FA" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#E9EEF5" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F3F6FA" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#152235" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#536277" />
          <SolidColorBrush x:Key="BorderBrush" Color="#D9E1EA" />
          <SolidColorBrush x:Key="AccentBrush" Color="#1459B5" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEAFB" />
          <SolidColorBrush x:Key="WarningBrush" Color="#8D4700" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF0D8" />
          <SolidColorBrush x:Key="FocusBrush" Color="#005FCC" />
          <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="InfoBrush" Color="#1459B5" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#A92525" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CanvasBrush" Color="#171819" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#202123" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#282A2C" />
          <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#333638" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F2" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#BEC2C4" />
          <SolidColorBrush x:Key="BorderBrush" Color="#53575A" />
          <SolidColorBrush x:Key="AccentBrush" Color="#A9C7FA" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#303F57" />
          <SolidColorBrush x:Key="WarningBrush" Color="#FFD18A" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#423427" />
          <SolidColorBrush x:Key="FocusBrush" Color="#A8CDFF" />
          <SolidColorBrush x:Key="TextOnAccentBrush" Color="#101923" />
          <SolidColorBrush x:Key="InfoBrush" Color="#A9C7FA" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#FFABA8" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    </Style>
    <Style Selector="Button, TextBox, ComboBox, ComboBoxItem, CheckBox, ListBoxItem, Expander">
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    </Style>
    <Style Selector="Button, TextBox, ComboBox">
      <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="{DynamicResource SectionFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="Padding" Value="{DynamicResource SpaceLarge}" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="{DynamicResource NavPadding}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:focus, ComboBox:focus, TextBox:focus, CheckBox:focus, ListBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
      <views:DevicesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DesktopPreferencesViewModel}">
      <views:DesktopPreferencesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
      <views:ProfilesView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
