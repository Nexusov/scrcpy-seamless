<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ScrcpySeamless.Desktop.Views"
             xmlns:vm="using:ScrcpySeamless.Desktop.Presentation"
             x:Class="ScrcpySeamless.Desktop.App">
  <Application.Resources>
    <ResourceDictionary>
      <Thickness x:Key="SpaceSmall">8</Thickness>
      <Thickness x:Key="SpaceMedium">16</Thickness>
      <Thickness x:Key="SpaceLarge">24</Thickness>
      <Thickness x:Key="SpaceSection">32</Thickness>
      <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
      <CornerRadius x:Key="RadiusCard">14</CornerRadius>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7FA" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#E9EEF5" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F3F6FA" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#152235" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#536277" />
          <SolidColorBrush x:Key="BorderBrush" Color="#D9E1EA" />
          <SolidColorBrush x:Key="AccentBrush" Color="#1459B5" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEAFB" />
          <SolidColorBrush x:Key="WarningBrush" Color="#8D4700" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF0D8" />
          <SolidColorBrush x:Key="FocusBrush" Color="#005FCC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CanvasBrush" Color="#101923" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#172331" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1D2B3B" />
          <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#25364A" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F6FB" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#B2C1D1" />
          <SolidColorBrush x:Key="BorderBrush" Color="#354960" />
          <SolidColorBrush x:Key="AccentBrush" Color="#8AB8FF" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#253F62" />
          <SolidColorBrush x:Key="WarningBrush" Color="#FFD18A" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#5A3C1E" />
          <SolidColorBrush x:Key="FocusBrush" Color="#A8CDFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="Padding" Value="{StaticResource SpaceLarge}" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:focus, ComboBox:focus, TextBox:focus, CheckBox:focus, ListBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
      <views:DevicesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
